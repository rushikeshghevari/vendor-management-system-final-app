{
  "name": "vendor-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Vendor Management System monorepo (mobile + backend)",
  "scripts": {
    "install:all": "npm install --prefix mobile && npm install --prefix backend",
    "dev:mobile": "npm run start --prefix mobile",
    "dev:mobile:tunnel": "npm run start:tunnel --prefix mobile",
    "dev:backend": "npm run dev --prefix backend",
    "build:backend": "npm run build --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "typecheck:mobile": "npm run typecheck --prefix mobile",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "typecheck": "npm run typecheck:mobile && npm run typecheck:backend",
    "build": "npm install --prefix backend && npm run build --prefix backend",
    "start": "npm run start --prefix backend"
  }
}
