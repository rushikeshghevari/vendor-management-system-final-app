NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vendor_management_system

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
# Comma-separated list of allowed origins, or * to reflect any origin (safe with credentials: true in app.ts).
# Development: use * when the backend is exposed via Cloudflare Tunnel (URL changes on every restart).
# Production: set to the exact deployed frontend URL, e.g. https://yourapp.com
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Google Gemini AI — required for Module 4 AI Verification.
# If not set, the system falls back to Rule Engine only (still functional).
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Firebase Cloud Messaging (push notifications)
# Required for FCM push. If absent, push is silently skipped (in-app notifications still work).
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=vendor-management-erp
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vendor-management-erp.iam.gserviceaccount.com
# Paste the raw private key value (with literal \n between lines — Railway/Render handle this):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Initial Super Admin (used by `npm run seed`)
# NOTE: the weak default password is only accepted when NODE_ENV=development — see user.model.ts
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@gmail.com
SEED_SUPER_ADMIN_PASSWORD=1
