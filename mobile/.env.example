# Base URL of the backend API (Node/Express server).
# When testing with Expo Tunnel mode on a physical iPhone/Android device,
# "localhost" will NOT work — the request runs on the device, not your PC.
# Use one of:
#   - Your machine's LAN IP, e.g. http://192.168.1.50:5000/api/v1  (same WiFi)
#   - A tunnel to your backend itself, e.g. an ngrok URL             (any network)
#   - A deployed staging backend URL
EXPO_PUBLIC_API_URL=http://192.168.1.50:5000/api/v1

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT=15000

# "development" | "staging" | "production"
EXPO_PUBLIC_APP_ENV=development
